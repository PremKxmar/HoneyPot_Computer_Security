# ---- Backend (Flask) ----

# Signing key for JWT session tokens. MUST be set in any deployed environment.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database connection string.
# Defaults to a local SQLite file (sqlite:///database.db) when unset.
# For Render/Railway Postgres, paste the provided URL here, e.g.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=
