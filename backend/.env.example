# ---- Backend (Flask) ----

# Signing key for JWT session tokens. MUST be set in any deployed environment.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Number of reverse proxies between the internet and this app.
# Managed hosts (Render, Railway, Fly) put at least one in front, which is why
# request.remote_addr would otherwise be 127.0.0.1 for every attacker.
# Set to 0 when running directly on a public port with no proxy.
# Verify after deploying: GET /api/debug/client-ip
PROXY_HOPS=1

# Optional. A free MaxMind licence key lets the build download GeoLite2-City so
# attacks geolocate for real rather than to simulated cities.
# Sign up at https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# Database connection string.
# Defaults to a local SQLite file (sqlite:///database.db) when unset.
# For Render/Railway Postgres, paste the provided URL here, e.g.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=
