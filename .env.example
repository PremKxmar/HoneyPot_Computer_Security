# ---- Frontend (read by vite.config.ts at build time) ----

# Base URL of the Flask backend.
# Leave blank for local development: the Vite dev proxy forwards /api to :5000.
# Set it when the dashboard and backend are deployed to different hosts,
# e.g. BACKEND_URL=https://your-backend.onrender.com
BACKEND_URL=

# Google Gemini API key for the in-dashboard AI security assistant.
# Optional: without it the chat panel shows a "not configured" message.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
